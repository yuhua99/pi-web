{
  "name": "@yuhua99/pi-web",
  "version": "1.0.0",
  "description": "Pi extension adding webfetch and websearch tools — markdown extraction, Exa-powered search, and cookie-based Reddit/X support",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "typecheck": "oxlint --type-aware --type-check"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "iconv-lite": "^0.6.3",
    "jsdom": "^24.0.0",
    "turndown": "^7.1.2",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.2.3",
    "@types/turndown": "^5.0.6",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
